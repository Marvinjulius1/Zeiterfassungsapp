# Lokale Entwicklung: Werte aus `pnpm db:start` bzw. `pnpm exec supabase status`
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Zeigt im Login die Demo-Schnell-Logins (nur lokal, niemals in Produktion!)
NEXT_PUBLIC_DEMO_MODE=true

# Nur serverseitig! Für den Compliance-Evaluator und Cron-Jobs (Wert: SECRET_KEY aus `supabase status`)
SUPABASE_SECRET_KEY=sb_secret_...

# Schützt /api/cron/* (beliebiger langer Zufallswert)
CRON_SECRET=

# Geheimer Pepper für PIN- und RFID-Hashes (≥ 32 Zeichen). In Produktion PFLICHT und NIE ändern –
# sonst funktionieren vergebene PINs und Chips nicht mehr. Lokal leer lassen = Demo-PINs funktionieren.
ZEITGEIST_PEPPER=

{
  "name": "zeitgeist",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset && pnpm compliance:run",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript > src/lib/supabase/database.types.ts",
    "check": "pnpm typecheck && pnpm lint && pnpm test && pnpm db:test",
    "compliance:run": "tsx --env-file=.env.local --conditions=react-server scripts/evaluate-all.ts",
    "app:sync": "cap sync",
    "app:ios": "cap sync ios && cap open ios",
    "app:android": "cap sync android && cap open android",
    "app:ios:run": "cap sync ios && cap run ios",
    "app:android:run": "adb reverse tcp:3000 tcp:3000 && adb reverse tcp:54321 tcp:54321 && cap sync android && cap run android"
  },
  "dependencies": {
    "@capacitor/android": "8.6.2",
    "@capacitor/app": "8.1.2",
    "@capacitor/core": "8.6.2",
    "@capacitor/filesystem": "8.1.5",
    "@capacitor/haptics": "8.0.2",
    "@capacitor/ios": "8.6.2",
    "@capacitor/push-notifications": "8.1.3",
    "@capacitor/share": "8.0.3",
    "@capacitor/splash-screen": "8.0.2",
    "@capacitor/status-bar": "8.0.4",
    "@date-fns/tz": "^1.5.0",
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.119.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.4.0",
    "exceljs": "^4.4.0",
    "idb-keyval": "^6.3.0",
    "jsqr": "^1.4.0",
    "lucide-react": "^1.73.0",
    "motion": "^14.14.0",
    "next": "16.4.6",
    "pdf-lib": "^1.17.1",
    "qrcode": "^1.5.4",
    "radix-ui": "^1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "^0.0.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2",
    "web-push": "^4.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@capacitor/cli": "8.6.2",
    "@tailwindcss/turbopack": "4.3.3",
    "@types/node": "^22.20.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/web-push": "^3.6.4",
    "@vitest/coverage-v8": "^5.1.0",
    "axe-core": "^4.14.1",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "supabase": "^3.2.0",
    "tailwindcss": "4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.1.0"
  },
  "packageManager": "pnpm@10.28.0"
}
